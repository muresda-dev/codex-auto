{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ReasoningEffort": {
      "description": "A non-empty reasoning effort value advertised by the model.",
      "minLength": 1,
      "type": "string"
    }
  },
  "properties": {
    "confidence": {
      "default": 0,
      "format": "uint8",
      "minimum": 0.0,
      "type": "integer"
    },
    "escalatedRetry": {
      "default": false,
      "type": "boolean"
    },
    "inheritedPrevious": {
      "default": false,
      "type": "boolean"
    },
    "model": {
      "type": "string"
    },
    "reasoningEffort": {
      "$ref": "#/definitions/ReasoningEffort"
    },
    "routeClass": {
      "default": "",
      "type": "string"
    },
    "signals": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "solOverTerraGain": {
      "default": 0,
      "format": "uint8",
      "minimum": 0.0,
      "type": "integer"
    },
    "terraOverLunaGain": {
      "default": 0,
      "format": "uint8",
      "minimum": 0.0,
      "type": "integer"
    },
    "threadId": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    },
    "usedFallback": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "model",
    "reasoningEffort",
    "threadId",
    "turnId"
  ],
  "title": "AutoModelRouteSelectedNotification",
  "type": "object"
}